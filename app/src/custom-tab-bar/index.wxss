.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  height: 50px;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(14, 14, 14, 0.95);
  border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  opacity: 0.6;
  position: relative;
}

.tab-item.active {
  opacity: 1;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #d4af37;
  border-radius: 2rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #e2e2e2;
  letter-spacing: 2rpx;
}
